{
  "name": "kafka-cdl-consumer",
  "version": "2.0.17",
  "config": {
    "unsafe-perm": true
  },
  "private": true,
  "bin": {
    "app": "bin/app.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "postinstall": "find ./src -maxdepth 3 -type d ! -path \"*node_modules*\" -exec sh -c \"test -f {}/package.json && (test -f .npmrc && cp .npmrc {} || true) && cd {} && npm ci\" \\;",
    "synth-main": "npm run build && cdk synth *MainStack --no-staging > template.yml",
    "synth-secondary": "npm run build && cdk synth *SecondaryStack --no-staging > secondary-template.yml",
    "synth-template": "npm run synth-main",
    "clean": "npm run cleanJS; npm run cleanModules;",
    "cleanJS": "find ./src \\( -name \"*.js\" -o -name \"*.js.map\" \\) -delete ",
    "cleanModules": "rm -rf node_modules  && find ./src  -name 'node_modules' -type d -prune -exec rm -rf '{}' +",

    "lint": "npx eslint --ext .jsx,.js,.tsx,.ts .",
    "lint:errors": "npx eslint --ext .jsx,.js,.tsx,.ts .",
    "lint:fix": "npx lint --fix",
    "style": "npx prettier --check .",
    "style:fix": "npx prettier --write .",
    "lefthook:pre-commit": "npx lefthook run pre-commit",
    "lefthook:fix-styles": "npx lefthook run fix-styles"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10.2.4"
  },
  "type": "commonjs",
  "license": "UNLICENSED",
  "devDependencies": {
    "@aws-sdk/client-ssm": "^3.341.0",
    "@aws-sdk/types": "^3.341.0",
    "@michelin/eslint-config": "^1.2.8",
    "@trivago/prettier-plugin-sort-imports": "^3.3.0",
    "@types/aws-lambda": "8.10.115",
    "@types/jest": "29.4.0",
    "@types/node": "18.14.6",
    "@typescript-eslint/eslint-plugin": "^5.13.0",
    "@typescript-eslint/parser": "^5.0.0",
    "aws-cdk": "2.175.1",
    "eslint": "^8.18.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-airbnb-typescript": "^17.0.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-import": "^2.25.3",
    "eslint-plugin-jest": "^26.7.0",
    "eslint-plugin-promise": "^6.1.1",
    "eslint-plugin-unicorn": "^43.0.2",
    "jest": "29.5.0",
    "lefthook": "^1.1.1",
    "prettier": "^2.7.1",
    "ts-jest": "29.0.5",
    "ts-node": "10.9.1",
    "tsconfig-paths": "4.2.0",
    "typescript": "4.9.5"
  },
  "dependencies": {
    "@michelin/authorizer-users-apps": "3.0.4",
    "@michelin/cdk-pipeline": "2.175.0",
    "@michelin/cdk-listener-next-priority": "2.175.2",
    "aws-cdk-lib": "2.175.0",
    "constructs": "10.2.21"
  }
}
